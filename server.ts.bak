    const { data, error } = await sb
      .from('daily_tasks')
      .select('*')
      .eq('venue_id', venueId)
      .order('created_at', { ascending: false });

    if (error) return res.status(500).json({ error: error.message });
    res.json(data || []);
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
});

app.post('/api/supabase/daily-tasks', async (req: Request, res: Response) => {
  const sb = getSupabase();
  if (!sb) return res.status(503).json({ error: 'Supabase not configured' });

  const task = req.body;
  if (!task || !task.id) return res.status(400).json({ error: 'Task object with id required' });

  try {
    const now = new Date().toISOString();
    const payload = {
      id: task.id,
      venue_id: task.venueId || DEFAULT_VENUE_ID,
      date: task.date || now.split('T')[0],
      title: task.title,
      notes: task.notes || task.description || null,
      priority: task.priority || 'NORMAL',
      status: task.status || (task.status === 'DONE' ? 'DONE' : 'PENDING'),
      is_done: task.status === 'DONE' || Boolean(task.isDone),
      department_id: task.departmentId || 'dept-server',
      area_id: task.areaId || null,
      area_name: task.areaName || null,
      venue_name: task.venueName || null,
      assigned_to_name: task.assignedUserName || task.assignedToName || null,
      created_by_user_id: task.createdByUserId || 'user-manager',
      created_by_name: task.createdByName || 'General Manager',
      started_at: task.startedAt || null,
      started_by_user_id: task.startedByUserId || null,
      started_by_name: task.startedByName || null,
      completed_at: task.completedAt || null,
      completed_by_id: task.completedByUserId || null,
      completed_by_name: task.completedByName || null,
      completion_reason: task.notDoneReason || task.completionReason || null,
      completion_note: task.completionNote || task.completionNotes || null,
      history: Array.isArray(task.history) ? task.history : [],
      created_at: task.createdAt || now,
      updated_at: now
    };

    const { error } = await sb.from('daily_tasks').upsert(payload);
    if (error) return res.status(500).json({ error: error.message });

    broadcastSse('TASKS_UPDATED', { taskId: task.id });
    res.json({ ok: true });
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
});

app.delete('/api/supabase/daily-tasks/:id', async (req: Request, res: Response) => {
  const sb = getSupabase();
  if (!sb) return res.status(503).json({ error: 'Supabase not configured' });

  const { id } = req.params;
  const venueId = (req.query.venueId as string) || (req.headers['x-venue-id'] as string) || DEFAULT_VENUE_ID;
  const userRole = (req.headers['x-user-role'] as string) || '';

  if (userRole && userRole === 'STAFF') {
    return res.status(403).json({ error: 'Staff cannot delete daily tasks' });
  }

  try {
    const { error } = await sb.from('daily_tasks').delete().eq('id', id).eq('venue_id', venueId);
    if (error) return res.status(500).json({ error: error.message });

    broadcastSse('TASKS_UPDATED', { taskId: id, deleted: true });
    res.json({ ok: true });
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
});

